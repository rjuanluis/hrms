FROM ghcr.io/rjuanluis/ayp-hrms:production
USER root
RUN mkdir -p /var/lib/apt/lists/partial \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends \
      antiword \
      libheif-examples \
      poppler-utils \
      tesseract-ocr \
      tesseract-ocr-eng \
      tesseract-ocr-spa \
    && rm -rf /var/lib/apt/lists/*
COPY --chown=frappe:frappe hrms/ /home/frappe/frappe-bench/apps/hrms/hrms/
COPY docker/patch_frappe_bootstrap.py /tmp/patch_frappe_bootstrap.py
COPY docker/patch_frappe_naming_bootstrap.py /tmp/patch_frappe_naming_bootstrap.py
COPY --chown=frappe:frappe docker/configure_ayp_document_queue.py /usr/local/bin/configure-ayp-document-queue
RUN chmod 0755 /usr/local/bin/configure-ayp-document-queue
RUN python3 /tmp/patch_frappe_bootstrap.py \
      /home/frappe/frappe-bench/apps/frappe/frappe/database/mariadb/framework_mariadb.sql \
    && python3 /tmp/patch_frappe_naming_bootstrap.py \
      /home/frappe/frappe-bench/apps/frappe/frappe/model/naming.py \
    && rm -f /tmp/patch_frappe_bootstrap.py /tmp/patch_frappe_naming_bootstrap.py
USER frappe
